{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "margin-bottom": 0,
    "fixed-center": true,

    "modules-left": [
        "custom/apps",
        "ext/workspaces",
        "custom/sep",
        "hyprland/window"
    ],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu",
        "memory",
        "custom/gpu",
        "network",
        "pulseaudio",
        "bluetooth",
        "tray"
    ],

    // ext/workspaces instead of hyprland/workspaces: Waybar 0.15's
    // hyprland/workspaces sends old-style "dispatch workspace N", which
    // Hyprland 0.57 rejects, so clicks did nothing. ext/workspaces switches
    // via the ext-workspace Wayland protocol. Switch back once a Waybar
    // release includes Alexays/Waybar#5013 (Hyprland Lua dispatch).
    //
    // No persistent-workspaces needed: Hyprland's workspace rules
    // (hyprland.lua) keep 1-10 alive, odd on DP-1 and even on DP-2, and each
    // bar shows only the workspaces of its own monitor.
    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    "custom/sep": {
        "format": "",
        "tooltip": false
    },

    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 5,
        "format": "󰧴 {used:0.1f}G",
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    },

    "custom/gpu": {
        // gpu.sh prints JSON: bar text (GPU load + temp) and a tooltip
        // with the main system temperatures (CPU, GPU, SSD, RAM, chipset)
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "tooltip": true
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰖪 Down",
        "on-click": "kitty -e nmtui",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 Muted",
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "on-click": "blueman-manager",
        "tooltip-format": "{controller_alias}\n{num_connections} connected"
    },

    "battery": {
        "format": "󰂄 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-low": "󰁻 {capacity}%",
        "states": { "warning": 30, "critical": 20 }
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    "clock": {
        "format": "{0:%H:%M}  <span text_transform='uppercase'>{0:%a}</span> · {0:%d} <span text_transform='uppercase'>{0:%b}</span>",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
    },

    "custom/apps": {
        "format": "󰃤",
        "on-click": "~/.config/waybar/scripts/window-switcher.sh",
        "tooltip": false
    }
}
